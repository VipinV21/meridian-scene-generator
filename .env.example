# Copy this file to backend/.env (or export these directly) and fill in ONE key.
# Never commit the real .env -- it's already covered by backend/.gitignore.
#
# Provider priority if more than one is set: OPENAI_API_KEY > GEMINI_API_KEY > GROQ_API_KEY.
# Any one of these is enough to enable live scene generation and the LLM-based
# semantic verifier layer. With none set, the app still runs end-to-end using
# the six curated offline fallback scenes (clearly labelled as such in the UI).

OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
